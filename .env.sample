# x402 POC — testnet burners (Base Sepolia). Copy to .env and fill in.

# empty = recycle mode: payTo of /weather & /compute = the agent's own wallet below
SELLER_ADDRESS_A=
# scam payTo for /data. The Intercepta mock flags this address and clears A.
SELLER_ADDRESS_B=

# Mock Intercepta (packages/intercepta), also mounted on the seller.
# Header: X-API-KEY. Account B above is the only scam account.
INTERCEPTA_API_KEY=tg_mock_intercepta
INTERCEPTA_BASE_URL=http://127.0.0.1:4020

# agent buyer EOA (burner) — fund this with USDC on Base Sepolia once:
# https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
EVM_PRIVATE_KEY=
