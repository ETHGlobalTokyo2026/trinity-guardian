# ---- agent wallet (buyer) ----
# Burner EOA the agent signs x402 payments with. Fund it with Base Sepolia USDC: https://faucet.circle.com
AGENT_PRIVATE_KEY=0x...

# ---- x402 ----
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Where the legitimate demo services get paid (any address you control)
SELLER_ADDRESS=0x209693Bc6afc0C5328bA36FaF03C514EF312287C
# A real mainnet address that carries a scam / phishing flag in Intercepta's data
# (take one of the pinned test addresses from the Intercepta Discord channel)
SCAM_PAYTO_ADDRESS=0x...
# A token that is not USDC, used by the lookalike scenario (any mainnet scam token address)
LOOKALIKE_USDC_ADDRESS=0x...

# ---- Intercepta (https://intercepta.io/ethglobal) ----
INTERCEPTA_API_KEY=
INTERCEPTA_BASE_URL=https://api.web3antivirus.io

# ---- World ID for Agents (https://sandbox.auth.world.org/portal) ----
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# optional: pairwise sub of the owner; proofs from any other human are rejected
WORLD_OWNER_SUB=
# dev only: lets the dashboard resolve approvals without a proof while no client is registered
WORLD_DEV_BYPASS=false

# ---- owner controls ----
# Required on any public deployment: guards the routes that flip the on-chain mandate,
# reset demo state, and the dev-bypass. Leave empty for local development.
ADMIN_TOKEN=

# ---- policy ----
POLICY_PER_TX_MAX=5
POLICY_DAILY_CAP=50
POLICY_EXPIRES=2026-09-28T00:00:00Z
APPROVAL_TIMEOUT_MS=300000
APP_BASE_URL=http://localhost:3000

# ---- ENSv2 on Sepolia (layer 1: the mandate on chain) ----
# Owner key, funded with a little Sepolia ETH (https://sepoliafaucet.com). Registers names and flips the spend role. Never the agent key.
ENS_OWNER_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_LABEL=payguard
ENS_AGENT_LABEL=momo
ENS_SELLER_LABEL=weather
# printed by `yarn mandate setup`
ENS_USER_REGISTRY=
ENS_RESOLVER=
