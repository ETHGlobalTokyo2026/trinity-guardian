{
  "name": "@trinity-guardian/ens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:watch": "vitest",
  "rpc:check": "node --env-file=.env.local --experimental-strip-types scripts/check-rpc.ts",
  "ens:check": "node --env-file=.env.local --experimental-strip-types scripts/check-ens.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
